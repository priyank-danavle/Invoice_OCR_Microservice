# ── Mistral AI ────────────────────────────────────────────────────────────────
# Get your key at https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# ── Google Gemini AI ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_PARSE_MODEL=gemini-3.5-flash-lite





# ── Microservice Auth ─────────────────────────────────────────────────────────
# Any strong random string — used as Bearer token for API requests
# Generate with: openssl rand -hex 32
MICROSERVICE_API_KEY=your-microservice-api-key-here

# ── MySQL (read-only connection) ──────────────────────────────────────────────
# Since MySQL runs on the same server as Docker:
#   • Use 172.17.0.1 (Docker bridge gateway) to reach the host's MySQL
#   • OR grant MySQL access to 172.17.0.0/16 subnet
#   • Do NOT use "localhost" — inside the container that means the container itself
DB_HOST=172.17.0.1
DB_PORT=3306
DB_NAME=prod_dump
DB_USER=ocr_readonly
DB_PASSWORD=your-db-password-here
DB_READ_TIMEOUT=10

# ── Entity Index ──────────────────────────────────────────────────────────────
ENTITY_INDEX_TTL_MINUTES=60

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your ERP frontend domain(s), comma-separated
ALLOWED_ORIGINS=https://your-erp-domain.com,http://localhost:4200

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8001
